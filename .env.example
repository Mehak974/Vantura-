# Environment variables for Brenve Production
# Do not commit the actual .env file to Git!

# Set to 'production' to use PostgreSQL and production settings
ENV=production

# Django Settings
DEBUG=False
DJANGO_SECRET_KEY=your_secure_random_secret_key_here
ALLOWED_HOSTS=brenve.com,www.brenve.com

# PostgreSQL Database Settings
DB_NAME=disilvki_brenve_db
DB_USER=disilvki_brenve_user
